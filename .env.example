# ==========================================================
#  Lettuce Management API - Environment Configuration
#  Salin file ini menjadi `.env` lalu sesuaikan nilainya.
# ==========================================================

# ----- Aplikasi -----
APP_NAME="Lettuce Management API"
APP_VERSION=1.0.0
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1
PUBLIC_BASE_URL=http://localhost:8000

# ----- Database -----
# Default: SQLite (kosongkan / komentari untuk memakai hidroponik_selada.db di root project)
# DATABASE_URL=sqlite:///./hidroponik_selada.db
# MySQL (sesuai konteks_erd.md):
# DATABASE_URL=mysql+pymysql://root:password@localhost:3306/hidroponik_selada
# PostgreSQL:
# DATABASE_URL=postgresql+psycopg2://postgres:password@localhost:5432/hidroponik_selada
SQL_ECHO=false

# ----- JWT -----
JWT_SECRET_KEY=ganti-dengan-secret-key-yang-panjang-dan-acak
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=720

# ----- CORS -----
CORS_ORIGINS=http://localhost,http://localhost:8000,http://127.0.0.1:8000,http://localhost:8080

# ----- Upload & Model AI -----
MAX_UPLOAD_SIZE_MB=5
DIAGNOSIS_MODEL_FILE=best_lettuce_yolo26_v2.pt
DIAGNOSIS_TEMPERATURE_FILE=temperature.txt

# ----- Seeder (tabel `users`: nama, username, password, role) -----
SEED_OWNER_NAMA="Pemilik Mitra"
SEED_OWNER_USERNAME=owner
SEED_OWNER_PASSWORD=owner123
SEED_KARYAWAN_NAMA="Staf Kebun"
SEED_KARYAWAN_USERNAME=karyawan
SEED_KARYAWAN_PASSWORD=karyawan123
SEED_SAMPLE_DATA=true
